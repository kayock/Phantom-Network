{
  "name": "Phantom Network",
  "short_name": "Phantom",
  "description": "Local LAN command center — files, messaging, audio and monitoring for your private network. No cloud.",
  "id": "/?src=pwa",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0c14",
  "theme_color": "#0a0c14",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "/assets/favicon.png", "sizes": "64x64", "type": "image/png" },
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "GhostChat",
      "short_name": "Chat",
      "description": "Open GhostChat inbox",
      "url": "/#/chat",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "File Commander",
      "short_name": "Files",
      "description": "Open File Commander",
      "url": "/#/commander",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Network Radar",
      "short_name": "Radar",
      "description": "See the fleet",
      "url": "/#/radar",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Phantom Mobile",
      "short_name": "Mobile",
      "description": "Open the mobile interface (for phones and tablets)",
      "url": "/m",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
